{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnlyai.local/schemas/source.schema.json",
  "title": "LearnlyAI Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "name",
    "organization",
    "subject",
    "language",
    "source_type",
    "official_url",
    "license",
    "rag_permission_status",
    "priority",
    "recommended_usage"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "content_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "license_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "rag_permission_status": {
      "type": "string",
      "enum": [
        "allowed",
        "internally_authored",
        "reference_only",
        "unclear",
        "do_not_ingest"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "recommended_usage": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}