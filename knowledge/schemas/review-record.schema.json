{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnlyai.local/schemas/review-record.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "review_id", "source_id", "artifact_id", "artifact_sha256", "normalized_unit", "source_document", "chapter", "section", "asset_locator", "asset_kind", "latex", "plain_text", "review_status", "reviewer", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_unit": {"type": "string", "minLength": 1},
    "source_document": {"type": "string", "minLength": 1},
    "chapter": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "asset_locator": {"type": "string", "minLength": 1},
    "asset_kind": {"enum": ["math_image", "image"]},
    "latex": {"type": "string", "maxLength": 10000},
    "plain_text": {"type": "string", "maxLength": 10000},
    "review_status": {"enum": ["verified", "needs_correction", "skipped"]},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [{
    "if": {"properties": {"review_status": {"const": "verified"}}, "required": ["review_status"]},
    "then": {
      "properties": {"plain_text": {"type": "string", "minLength": 1, "pattern": "\\S"}},
      "allOf": [{
        "if": {"properties": {"asset_kind": {"const": "math_image"}}, "required": ["asset_kind"]},
        "then": {"properties": {"latex": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
      }]
    }
  }]
}
