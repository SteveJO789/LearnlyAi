// use prisma-8

model User {
  id          String   @id @default(uuid())
  email       String?
  displayName String
  avatarUrl   String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  oauthAccounts   OAuthAccount[]
  appSessions     AppSession[]
  learningSessions LearningSession[]
  learningProfile LearningProfile?
}

model OAuthAccount {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  subject         String
  emailAtProvider String?
  createdAt       TimestamptzString @default(now())
  lastLoginAt     TimestamptzString?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, subject])
}

model AppSession {
  id          String   @id @default(uuid())
  userId      String
  tokenDigest String   @unique
  expiresAt   TimestamptzString
  createdAt   TimestamptzString @default(now())
  lastSeenAt  TimestamptzString?
  revokedAt   TimestamptzString?

  user User @relation(fields: [userId], references: [id])
}

enum LearningSessionState {
  ACTIVE
  COMPLETED
  FAILED
}

enum LearningStage {
  DIAGNOSE
  EXPLAIN
  PRACTICE
  ASSESS
  REVIEW
}

model LearningSession {
  id             String                @id @default(uuid())
  userId         String
  title          String
  learningGoal   String?
  subject        String?
  state          LearningSessionState
  stage          LearningStage @default(EXPLAIN)
  progressPercent Int
  version        Int                   @default(1)
  createdAt      TimestamptzString     @default(now())
  updatedAt      temporal.updatedAtString()
  completedAt    TimestamptzString?

  user             User             @relation(fields: [userId], references: [id])
  sourceMaterials  SourceMaterial[]
  messages         Message[]
  assessments      Assessment[]
  aiRequests       AIRequest[]

  @@index([userId, createdAt])
}

enum SourceMaterialType {
  TEXT
  PDF
  IMAGE
}

enum SourceMaterialStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model SourceMaterial {
  id                String                @id @default(uuid())
  learningSessionId String
  type              SourceMaterialType
  status            SourceMaterialStatus
  storageKey        String?
  normalizedText    String?
  contentHash       String
  mimeType          String
  sizeBytes         Int
  metadata          Json?

  learningSession LearningSession @relation(
    fields: [learningSessionId],
    references: [id]
  )
}

enum MessageRole {
  USER
  TUTOR
  SYSTEM
}

model Message {
  id                String      @id @default(uuid())
  learningSessionId String
  role              MessageRole
  content           Json
  createdAt         TimestamptzString @default(now())

  learningSession LearningSession @relation(
    fields: [learningSessionId],
    references: [id]
  )
}

enum AssessmentPhase {
  PRE
  POST
  TRANSFER
}

model Assessment {
  id                String             @id @default(uuid())
  learningSessionId String
  phase             AssessmentPhase
  score             Int?
  maxScore          Int?
  submittedAt       TimestamptzString?

  learningSession LearningSession @relation(
    fields: [learningSessionId],
    references: [id]
  )

  answers AssessmentAnswer[]

  @@unique([learningSessionId, phase])
}

model AssessmentAnswer {
  id           String @id @default(uuid())
  assessmentId String
  questionId   String
  response     Json
  isCorrect    Boolean?
  awardedScore Int?

  assessment Assessment @relation(
    fields: [assessmentId],
    references: [id]
  )
}

model LearningProfile {
  userId     String @id
  mastery    Json
  strengths  Json
  weakPoints Json
  updatedAt  TimestamptzString

  user User @relation(
    fields: [userId],
    references: [id]
  )
}

enum AIRequestStatus {
  PENDING
  SUCCESS
  FAILED
}

model AIRequest {
  id              String          @id @default(uuid())
  learningSessionId String
  requestId       String
  provider        String
  model           String
  operation       String
  status          AIRequestStatus
  latencyMs       Int?
  inputTokens     Int?
  outputTokens    Int?
  errorCode       String?
  promptSnapshot  Json?
  outputSnapshot  Json?
  createdAt       TimestamptzString @default(now())

  learningSession LearningSession @relation(
    fields: [learningSessionId],
    references: [id]
  )

  @@unique([requestId])
  @@index([learningSessionId, createdAt])
}
