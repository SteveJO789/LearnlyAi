# API runtime
PORT=8000
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional for the current in-memory demo; reserved for future PostgreSQL persistence.
DATABASE_URL="postgresql://user:password@localhost:5432/learnly"

# Google OIDC and application session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SESSION_SECRET=

# AI provider: mock or openrouter
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RETRIES=2

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Learnly AI

# Input limits
MAX_UPLOAD_BYTES=10485760
