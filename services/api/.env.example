# API runtime
PORT=8000
APP_ENV=development
# Local-only in-memory development endpoint. Defaults off; ignored on Vercel/production.
LEARNING_DEV_ROUTE_ENABLED=false
FRONTEND_URL=http://localhost:3000

# PostgreSQL persistence for authenticated learning sessions.
DATABASE_URL="postgresql://user:password@localhost:5432/learnly"

# Supabase Auth verification for Bearer tokens from the web app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Google OAuth and email login are managed in Supabase Auth (no Express OIDC secrets/session).

# AI provider: mock or openrouter
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RETRIES=2

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Learnly AI

# Binary input is fixed at 3 MiB by API validation and the private Storage bucket.
# No MAX_UPLOAD_BYTES override; PDF/image extraction also enforces page/text/pixel limits.
# Reviewed Knowledge retrieval. Vector is opt-in after migration/index verification.
KNOWLEDGE_RETRIEVAL_MODE=lexical
# Required only for vector mode; no claimed curriculum-wide calibrated default.
# KNOWLEDGE_EMBEDDING_MODEL=openai/text-embedding-3-small
# KNOWLEDGE_VECTOR_MIN_SIMILARITY=0.8
# KNOWLEDGE_VECTOR_TOP_K=3
