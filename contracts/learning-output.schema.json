{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnly-ai.local/schemas/learning-output.schema.json",
  "title": "Learnly AI Structured Tutor Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "responseId",
    "sessionId",
    "stage",
    "blocks",
    "progress",
    "citations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "responseId": { "$ref": "#/$defs/nonBlankString" },
    "sessionId": { "$ref": "#/$defs/nonBlankString" },
    "stage": {
      "enum": [
        "CONTENT_ANALYSIS",
        "PRE_TEST",
        "LEARNING",
        "TRANSFER",
        "POST_TEST",
        "COMPLETED"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "$comment": "The API validator also requires each block id to be unique within the response.",
      "items": { "$ref": "#/$defs/block" }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "canAdvance"],
      "properties": {
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "canAdvance": { "type": "boolean" },
        "nextAction": {
          "enum": ["ANSWER", "REQUEST_HINT", "SUBMIT_ASSESSMENT", "CONTINUE", null]
        }
      }
    },
    "citations": {
      "type": "array",
      "uniqueItems": true,
      "$comment": "The API validator also requires each citation id to be unique within the response.",
      "items": { "$ref": "#/$defs/citation" }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableTitle": {
      "anyOf": [
        { "$ref": "#/$defs/nonBlankString" },
        { "type": "null" }
      ]
    },
    "citationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlankString" }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/explanationBlock" },
        { "$ref": "#/$defs/guidedQuestionBlock" },
        { "$ref": "#/$defs/hintBlock" },
        { "$ref": "#/$defs/quizBlock" },
        { "$ref": "#/$defs/feedbackBlock" },
        { "$ref": "#/$defs/interactiveBlock" }
      ]
    },
    "explanationBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "type": { "const": "explanation" },
        "title": { "$ref": "#/$defs/nullableTitle" },
        "content": { "$ref": "#/$defs/nonBlankString" },
        "citationIds": { "$ref": "#/$defs/citationIds" }
      }
    },
    "guidedQuestionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content", "expectedInput"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "type": { "const": "guided_question" },
        "content": { "$ref": "#/$defs/nonBlankString" },
        "expectedInput": { "enum": ["TEXT", "CHOICE", "NUMBER"] },
        "choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "citationIds": { "$ref": "#/$defs/citationIds" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "expectedInput": { "const": "CHOICE" } },
            "required": ["expectedInput"]
          },
          "then": {
            "properties": { "choices": true },
            "required": ["choices"]
          },
          "else": { "not": { "required": ["choices"] } }
        }
      ]
    },
    "hintBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content", "level"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "type": { "const": "hint" },
        "title": { "$ref": "#/$defs/nullableTitle" },
        "content": { "$ref": "#/$defs/nonBlankString" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "quizBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "questionId", "prompt", "format"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "type": { "const": "quiz" },
        "questionId": { "$ref": "#/$defs/nonBlankString" },
        "prompt": { "$ref": "#/$defs/nonBlankString" },
        "format": { "enum": ["MULTIPLE_CHOICE", "SHORT_TEXT", "NUMBER"] },
        "choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "$comment": "The API validator also requires choice ids to be unique within this quiz.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/nonBlankString" },
              "label": { "$ref": "#/$defs/nonBlankString" }
            }
          }
        },
        "citationIds": { "$ref": "#/$defs/citationIds" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "format": { "const": "MULTIPLE_CHOICE" } },
            "required": ["format"]
          },
          "then": {
            "properties": { "choices": true },
            "required": ["choices"]
          },
          "else": { "not": { "required": ["choices"] } }
        }
      ]
    },
    "feedbackBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "type": { "const": "feedback" },
        "content": { "$ref": "#/$defs/nonBlankString" },
        "result": { "enum": ["CORRECT", "PARTIALLY_CORRECT", "TRY_AGAIN"] },
        "citationIds": { "$ref": "#/$defs/citationIds" }
      }
    },
    "interactiveBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "component", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "type": { "const": "interactive" },
        "component": { "enum": ["OHMS_LAW", "LINEAR_EQUATION", "LOGIC_GATE"] },
        "props": { "type": "object" },
        "citationIds": { "$ref": "#/$defs/citationIds" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sourceType"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "title": { "$ref": "#/$defs/nonBlankString" },
        "sourceType": { "enum": ["USER_MATERIAL", "TRUSTED_KNOWLEDGE_BASE"] },
        "url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "page": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
